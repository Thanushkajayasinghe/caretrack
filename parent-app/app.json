{
  "expo": {
    "name": "CareTrack Parent",
    "slug": "caretrack-parent",
    "scheme": "caretrack-parent",
    "owner": "tjayasinghe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caretrack.parent"
    },
    "android": {
      "package": "com.caretrack.parent",
      "adaptiveIcon": {
        "backgroundColor": "#070A13"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CareTrack needs your location to display your position relative to your child on the live map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CareTrack needs access to your photos to upload a child profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4c8926f7-acea-4512-a220-0aa2b1fa8239"
      }
    }
  }
}
